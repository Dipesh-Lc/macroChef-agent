# NOTE: the values below (MODEL_PROVIDER=gemini, GEMINI_API_KEY=AIxxxxx, ...)
# are masked reference values mirroring the maintainer's real .env shape, not
# working credentials. `mock` is the actual zero-setup default provider: it
# needs no API keys/config at all and is what a fresh clone should use.
MODEL_PROVIDER=gemini
MODEL_PROVIDER_FALLBACKS=mock

# Global model role overrides (leave as mock unless a provider is configured).
VISION_MODEL=mock
CHAT_MODEL=mock

# Experimental fridge-photo vision feature. Off by default.
# Even when true, extraction is mock unless a real MODEL_PROVIDER with credentials
# is also configured. Enable by setting to "true".
MACROCHEF_ENABLE_VISION=false

# Gemini / Google AI
GEMINI_API_KEY=AIxxxxx
GOOGLE_API_KEY=
GEMINI_BASE_URL=
GEMINI_API_VERSION=v1beta
GEMINI_CHAT_MODEL=gemini-3-flash-preview
GEMINI_CHAT_MODEL_FALLBACKS=gemini-3.1-flash-lite-preview
GEMINI_VISION_MODEL=gemini-3-flash-preview
GEMINI_VISION_MODEL_FALLBACKS=gemini-3.1-flash-lite-preview
GEMINI_THINKING_LEVEL=low
GEMINI_THINKING_BUDGET=

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=
OPENAI_VISION_MODEL=

# Anthropic / Claude
ANTHROPIC_API_KEY=
CLAUDE_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_API_VERSION=2023-06-01
ANTHROPIC_CHAT_MODEL=
ANTHROPIC_VISION_MODEL=

# --- Optional: benchmark cross-LLM comparison (Phase 2) ---
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Ollama / local OpenAI-compatible provider
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=
OLLAMA_VISION_MODEL=

MODEL_TIMEOUT_SECONDS=30

# USDA FoodData Central — grounds recipe macros in a real nutrition database
# instead of recipe-tag/LLM estimates. Get a free key at
# https://fdc.nal.usda.gov/api-key-signup.html
# Leave blank to run without a key: grounding degrades gracefully and reports
# recipes as "ungrounded" rather than guessing.
# USDA_API_KEY is also accepted as an alternate name for this same setting.
FDC_API_KEY=VCxxxxxxx
FDC_BASE_URL=https://api.nal.usda.gov/fdc/v1

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHROMA_PATH=./data/chroma
DATABASE_URL=sqlite:///./macrochef.db

# SPA rebuild W1a (app/spa.py) -- directory containing the built React SPA
# (Vite's `index.html` + `assets/`). Relative to the process's working
# directory, like CHROMA_PATH/DATABASE_URL above. Leave unset for local
# API-only dev (no `web/` build yet): the app degrades gracefully, logging a
# warning and skipping the SPA/static mounts (GET / then 404s; the JSON API
# and /health/docs are unaffected).
# MACROCHEF_WEB_DIST=./web/dist

# Signed session cookie secret (anonymous session identity) -- signs/verifies
# the session token in app/dependencies.py. Generate a real random value
# yourself (e.g. `openssl rand -hex 32`); never reuse this placeholder.
# Fail-closed by design: if this is left unset, BOTH the FastAPI process (at
# boot, see app.dependencies.validate_session_secret_at_startup) and the
# Streamlit process (on first token mint) REFUSE TO START/RUN, unless
# ALLOW_INSECURE_SESSION_SECRET is explicitly set (see below). This is never
# inferred from DATABASE_URL or any other setting -- never leave this unset
# in a public deployment.
SESSION_SECRET=changeme_replace_with_a_random_secret

# Explicit, localhost-only opt-in to run WITHOUT a real SESSION_SECRET above.
# When set (1/true/yes/on) and SESSION_SECRET is unset, the app falls back
# to a hardcoded, publicly-known development secret (a loud warning is
# logged on every use). This is the ONLY way to skip setting a real
# SESSION_SECRET -- there is deliberately no heuristic that infers "local
# dev" automatically. Leave unset for a normal local checkout with
# SESSION_SECRET filled in above; set to 1 only if you deliberately want to
# run without a real secret. MUST NEVER be set in a deployed environment --
# anyone who knows the hardcoded default could forge a session token and
# read/modify another user's saved recipe library.
ALLOW_INSECURE_SESSION_SECRET=

# Tri-state Secure attribute for the `mc_session` cookie minted by
# POST /session (app/api/routes_session.py, SPA rebuild W0). "auto"
# (default): Secure when the request itself is https, or a reverse proxy
# says the original request was (X-Forwarded-Proto: https). "always":
# Secure regardless of the request -- set this in production, since a
# spoofed X-Forwarded-Proto: http must never be able to silently drop
# Secure from a cookie that will actually reach the browser over TLS.
# "never": never Secure (plain http local dev only).
SESSION_COOKIE_SECURE=auto

# PostHog analytics -- request completed, plan generated, thumbs up/down, and
# return-visit events. Leave POSTHOG_API_KEY blank to disable analytics
# entirely: it is a silent no-op with no key (see app/services/analytics.py),
# so local dev, tests, and CI never phone home.
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Per-session rate limits (in-memory, single-process -- see
# app/services/rate_limiter.py) on the endpoints that drive paid LLM calls
# or heavy synchronous work. Defaults below are sane for a single-replica
# public hobby demo; only raise them alongside real usage data.
RATE_LIMIT_DISCOVER_MAX=20
RATE_LIMIT_DISCOVER_WINDOW_SECONDS=3600
RATE_LIMIT_RECOMMEND_MAX=20
RATE_LIMIT_RECOMMEND_WINDOW_SECONDS=3600
# Reindex re-embeds the whole corpus synchronously -- the tightest cap of
# the three by a wide margin.
RATE_LIMIT_REINDEX_MAX=2
RATE_LIMIT_REINDEX_WINDOW_SECONDS=3600

# /tools/* safety-tools endpoints (app/api/routes_safety_tools.py) -- keyed
# by caller IP, not a verified session (see app/dependencies.py
# require_safety_tools_rate_limit). Each call is a single deterministic
# function call, so the default budget is more generous than the other
# three buckets above.
RATE_LIMIT_SAFETY_TOOLS_MAX=60
RATE_LIMIT_SAFETY_TOOLS_WINDOW_SECONDS=3600

# Shareable plan URLs (app/api/routes_share.py). POST /share is keyed by
# the verified session user id (same pattern as RATE_LIMIT_DISCOVER_MAX
# above); GET /share/{id} is unauthenticated by design, so it is keyed by
# caller IP instead (same pattern as RATE_LIMIT_SAFETY_TOOLS_MAX).
RATE_LIMIT_SHARE_CREATE_MAX=20
RATE_LIMIT_SHARE_CREATE_WINDOW_SECONDS=3600
RATE_LIMIT_SHARE_VIEW_MAX=120
RATE_LIMIT_SHARE_VIEW_WINDOW_SECONDS=3600

# POST /session (app/api/routes_session.py, SPA rebuild W0) -- the
# anonymous session-mint/validate endpoint. Keyed by caller IP, not a
# verified session (this endpoint is pre-identity by definition -- see
# app.api.routes_session.require_session_mint_rate_limit). Every call
# counts against this bucket uniformly, including the 204-no-mint
# ("caller already has a valid session") branch.
RATE_LIMIT_SESSION_MAX=60
RATE_LIMIT_SESSION_WINDOW_SECONDS=3600

# Hugging Face Hub token — used by the Phase 2/3.5 model/dataset publish
# tooling (not read by the running app today). Not required for local
# mock/dev mode.
Hugging_Face_Token=hf_xxxxx
